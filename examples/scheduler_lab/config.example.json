{
  "credentials_file": "/etc/hairp/private/api.json",
  "ca_file": "/etc/hairp/private/ca.crt",
  "namespace": "hairp-scheduling-lab",
  "queue": "gpu-lab",
  "runtime_class": "hairp-lab-nvidia",
  "kubectl": "/usr/bin/kubectl",
  "kubeconfig": "/etc/hairp/private/lab.kubeconfig",
  "image": "registry.example.org/qualified-python-cuda@sha256:REPLACE_WITH_QUALIFIED_DIGEST",
  "nodes": [
    {
      "id": "gpu-lab-a",
      "label": "GPU A",
      "gpu": 1
    },
    {
      "id": "gpu-lab-b",
      "label": "GPU B",
      "gpu": 1
    }
  ],
  "slurm_node": "gpu-lab-c",
  "slurm_partition": "gpu-lab",
  "slurm_account": "research-lab",
  "slurm_qos": "normal",
  "slurm_transport": [
    "/usr/local/libexec/hairp-lab-slurm-transport"
  ],
  "lock_file": "/var/lib/hairp/scheduler-lab.lock",
  "heterogeneous": [
    {
      "name": "GPU CUDA workload",
      "device_class": "gpu",
      "workload_ref": "REPLACE_WITH_QUALIFIED_GPU_WORKLOAD",
      "profile_ref": "REPLACE_WITH_PROJECT_PROFILE"
    },
    {
      "name": "NPU inference workload",
      "device_class": "npu",
      "workload_ref": "REPLACE_WITH_QUALIFIED_NPU_WORKLOAD",
      "profile_ref": "REPLACE_WITH_PROJECT_PROFILE"
    }
  ],
  "multi_gpu": {
    "max_gpus": 3,
    "queue": "multi-gpu-poc",
    "node_selector": {
      "hairp.io/multi-gpu-poc": "true"
    },
    "nodes": [
      {
        "id": "gpu-lab-a",
        "label": "GPU A \u00b7 x86",
        "gpu": 1
      },
      {
        "id": "gpu-lab-b",
        "label": "GPU B \u00b7 x86",
        "gpu": 1
      },
      {
        "id": "gpu-lab-c",
        "label": "GPU C \u00b7 ARM64",
        "gpu": 1
      }
    ]
  }
}

{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "kueue.x-k8s.io/v1beta1",
      "kind": "ResourceFlavor",
      "metadata": {
        "name": "hairp-pool-jetson-a"
      },
      "spec": {
        "nodeLabels": {
          "hairp.io/gpu-pool-member": "jetson-a"
        },
        "topologyName": "hairp-lab-hostname"
      }
    },
    {
      "apiVersion": "kueue.x-k8s.io/v1beta1",
      "kind": "ResourceFlavor",
      "metadata": {
        "name": "hairp-pool-jetson-b"
      },
      "spec": {
        "nodeLabels": {
          "hairp.io/gpu-pool-member": "jetson-b"
        },
        "topologyName": "hairp-lab-hostname"
      }
    },
    {
      "apiVersion": "kueue.x-k8s.io/v1beta1",
      "kind": "ClusterQueue",
      "metadata": {
        "name": "hairp-gpu-pool"
      },
      "spec": {
        "namespaceSelector": {
          "matchExpressions": [
            {
              "key": "kubernetes.io/metadata.name",
              "operator": "In",
              "values": [
                "resource-advisor-lab",
                "hairp-scheduling-lab"
              ]
            }
          ]
        },
        "queueingStrategy": "BestEffortFIFO",
        "resourceGroups": [
          {
            "coveredResources": [
              "cpu",
              "memory",
              "nvidia.com/gpu",
              "nvidia.com/gpu.shared"
            ],
            "flavors": [
              {
                "name": "hairp-multi-gpu",
                "resources": [
                  {
                    "name": "cpu",
                    "nominalQuota": "3"
                  },
                  {
                    "name": "memory",
                    "nominalQuota": "3Gi"
                  },
                  {
                    "name": "nvidia.com/gpu",
                    "nominalQuota": "3"
                  },
                  {
                    "name": "nvidia.com/gpu.shared",
                    "nominalQuota": "0"
                  }
                ]
              },
              {
                "name": "hairp-pool-jetson-a",
                "resources": [
                  {
                    "name": "cpu",
                    "nominalQuota": "2"
                  },
                  {
                    "name": "memory",
                    "nominalQuota": "1Gi"
                  },
                  {
                    "name": "nvidia.com/gpu",
                    "nominalQuota": "0"
                  },
                  {
                    "name": "nvidia.com/gpu.shared",
                    "nominalQuota": "2"
                  }
                ]
              },
              {
                "name": "hairp-pool-jetson-b",
                "resources": [
                  {
                    "name": "cpu",
                    "nominalQuota": "2"
                  },
                  {
                    "name": "memory",
                    "nominalQuota": "1Gi"
                  },
                  {
                    "name": "nvidia.com/gpu",
                    "nominalQuota": "0"
                  },
                  {
                    "name": "nvidia.com/gpu.shared",
                    "nominalQuota": "2"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "kueue.x-k8s.io/v1beta1",
      "kind": "LocalQueue",
      "metadata": {
        "name": "gpu-pool",
        "namespace": "hairp-scheduling-lab"
      },
      "spec": {
        "clusterQueue": "hairp-gpu-pool"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ResourceQuota",
      "metadata": {
        "name": "project-gpu-ceiling",
        "namespace": "resource-advisor-lab"
      },
      "spec": {
        "hard": {
          "requests.nvidia.com/gpu": "3"
        }
      }
    }
  ]
}

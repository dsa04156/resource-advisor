{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "kueue.x-k8s.io/v1beta1",
      "kind": "ResourceFlavor",
      "metadata": {
        "name": "hairp-multi-gpu"
      },
      "spec": {
        "nodeLabels": {
          "hairp.io/multi-gpu-poc": "true"
        },
        "topologyName": "hairp-lab-hostname"
      }
    },
    {
      "apiVersion": "kueue.x-k8s.io/v1beta1",
      "kind": "ClusterQueue",
      "metadata": {
        "name": "hairp-multi-gpu"
      },
      "spec": {
        "namespaceSelector": {
          "matchLabels": {
            "kubernetes.io/metadata.name": "hairp-scheduling-lab"
          }
        },
        "queueingStrategy": "BestEffortFIFO",
        "resourceGroups": [
          {
            "coveredResources": [
              "cpu",
              "memory",
              "nvidia.com/gpu"
            ],
            "flavors": [
              {
                "name": "hairp-multi-gpu",
                "resources": [
                  {
                    "name": "cpu",
                    "nominalQuota": "3"
                  },
                  {
                    "name": "memory",
                    "nominalQuota": "3Gi"
                  },
                  {
                    "name": "nvidia.com/gpu",
                    "nominalQuota": "3"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "apiVersion": "kueue.x-k8s.io/v1beta1",
      "kind": "LocalQueue",
      "metadata": {
        "name": "multi-gpu-poc",
        "namespace": "hairp-scheduling-lab"
      },
      "spec": {
        "clusterQueue": "hairp-multi-gpu"
      }
    }
  ]
}

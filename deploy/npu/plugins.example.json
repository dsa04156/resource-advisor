{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "DaemonSet",
      "metadata": {
        "name": "ra-intel-npu-plugin",
        "labels": {
          "app": "intel-npu-plugin"
        },
        "namespace": "kube-system"
      },
      "spec": {
        "selector": {
          "matchLabels": {
            "app": "intel-npu-plugin"
          }
        },
        "updateStrategy": {
          "type": "RollingUpdate",
          "rollingUpdate": {
            "maxSurge": 0,
            "maxUnavailable": 1
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "intel-npu-plugin"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "intel-npu-plugin",
                "env": [
                  {
                    "name": "NODE_NAME",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "spec.nodeName"
                      }
                    }
                  }
                ],
                "image": "intel/intel-npu-plugin@sha256:aba92b11c1d9714e454fe6f3d5c5471d275a71446d39ee9478fafd765ac0922b",
                "imagePullPolicy": "IfNotPresent",
                "securityContext": {
                  "seLinuxOptions": {
                    "type": "container_device_plugin_t"
                  },
                  "readOnlyRootFilesystem": true,
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "seccompProfile": {
                    "type": "RuntimeDefault"
                  }
                },
                "resources": {
                  "requests": {
                    "memory": "45Mi",
                    "cpu": "40m"
                  },
                  "limits": {
                    "memory": "90Mi",
                    "cpu": "100m"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "devfs",
                    "mountPath": "/dev/accel",
                    "readOnly": true
                  },
                  {
                    "name": "sysfsaccel",
                    "mountPath": "/sys/class/accel",
                    "readOnly": true
                  },
                  {
                    "name": "kubeletsockets",
                    "mountPath": "/var/lib/kubelet/device-plugins"
                  }
                ],
                "args": [
                  "-shared-dev-num=1"
                ]
              }
            ],
            "volumes": [
              {
                "name": "devfs",
                "hostPath": {
                  "path": "/dev/accel"
                }
              },
              {
                "name": "sysfsaccel",
                "hostPath": {
                  "path": "/sys/class/accel"
                }
              },
              {
                "name": "kubeletsockets",
                "hostPath": {
                  "path": "/var/lib/kubelet/device-plugins"
                }
              }
            ],
            "nodeSelector": {
              "kubernetes.io/arch": "amd64",
              "kubernetes.io/hostname": "REPLACE_INTEL_NODE"
            },
            "automountServiceAccountToken": false
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "DaemonSet",
      "metadata": {
        "name": "ra-rockchip-device-plugin",
        "namespace": "kube-system"
      },
      "spec": {
        "selector": {
          "matchLabels": {
            "app": "ra-rockchip-device-plugin"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "ra-rockchip-device-plugin"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "nodeSelector": {
              "kubernetes.io/hostname": "REPLACE_ROCKCHIP_NODE",
              "kubernetes.io/arch": "arm64"
            },
            "containers": [
              {
                "name": "plugin",
                "image": "ghcr.io/squat/generic-device-plugin@sha256:ecad50564fac0d8559053b149e3a738db50ec5d3f932b811bb90c4595edb275b",
                "args": [
                  "--domain=rockchip.com",
                  "--device={\"name\":\"rk3399pro\",\"groups\":[{\"count\":1,\"usb\":[{\"vendor\":\"2207\",\"product\":\"0019\"}]}]}"
                ],
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "32Mi"
                  },
                  "limits": {
                    "cpu": "100m",
                    "memory": "96Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "plugins",
                    "mountPath": "/var/lib/kubelet/device-plugins"
                  },
                  {
                    "name": "dev",
                    "mountPath": "/dev",
                    "readOnly": true
                  },
                  {
                    "name": "sys",
                    "mountPath": "/sys",
                    "readOnly": true
                  }
                ],
                "terminationMessagePath": "/tmp/termination-log"
              }
            ],
            "volumes": [
              {
                "name": "plugins",
                "hostPath": {
                  "path": "/var/lib/kubelet/device-plugins",
                  "type": "Directory"
                }
              },
              {
                "name": "dev",
                "hostPath": {
                  "path": "/dev",
                  "type": "Directory"
                }
              },
              {
                "name": "sys",
                "hostPath": {
                  "path": "/sys",
                  "type": "Directory"
                }
              }
            ]
          }
        }
      }
    }
  ]
}
